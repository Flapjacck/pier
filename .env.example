# Copy to .env and set K3S_HOST to your VM's LAN IP (no secrets in this file).

K3S_HOST=
# Must match the Linux login on k3s-node (whoami on the VM), e.g. spen or spencer.
K3S_SSH_USER=spencer
KUBECONFIG_PATH=~/.kube/k3s-node.yaml

# Optional overrides (defaults shown)
# Defaults to ~/.ssh/id_ed25519 if present. Use a no-passphrase key for scripts, or run ssh-add first.
# K3S_SSH_IDENTITY_FILE=~/.ssh/id_ed25519
# K3S_KUBECONFIG_REMOTE=/etc/rancher/k3s/k3s.yaml
# K3S_API_PORT=6443
