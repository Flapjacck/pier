# HTTP bind (default 127.0.0.1 for dev; 0.0.0.0 requires PIER_API_TOKEN in deployment)
PORT=3000
HOST=127.0.0.1

# API security: bearer token for all routes except /health (k8s probes).
# Generate one with: openssl rand -hex 32
# Leave empty for dev on loopback only (HOST must be 127.x, ::1 or localhost).
PIER_API_TOKEN=

# Kubernetes namespace for pier app workloads (read by GET /apps and POST /apps)
PIER_NAMESPACE=pier-apps

# Wildcard DNS suffix for app ingress hosts (e.g. apps.example.internal or <node-ip>.nip.io).
# Used by POST /apps to validate host parameter. Empty disables host-based ingress.
PIER_INGRESS_DOMAIN=

# Optional: path to public directory for serving the dashboard (defaults to ../public from dist).
# Used in development to test static serving. Leave empty in production (built into image).
PIER_PUBLIC_DIR=

# Optional: which proxies may set X-Forwarded-For / X-Forwarded-Proto.
# false (default), true (trust every hop: clients can spoof their IP), or a
# comma-separated IP/CIDR list of your proxy, e.g. 10.42.0.0/16 (k3s pods / Traefik).
PIER_TRUST_PROXY=

# Optional: DNS hostname for the dashboard (e.g. pier.example.com).
# Reserved in POST /api/apps to prevent app name collision.
PIER_DASHBOARD_HOST=

# Optional: cert-manager ClusterIssuer that signs app and dashboard Ingress certs (#29).
# Empty = HTTP only (no change). pier-ca is the LAN CA from k8s/tls.yaml; install
# cert-manager first with ./scripts/install-cert-manager.sh. See k8s/README.md#tls.
PIER_TLS_ISSUER=

# deploy-local.sh: false skips k8s/traefik-config.yaml (k3s Traefik externalTrafficPolicy:
# Local, which keeps the real client IP for the login limiter and audit log).
PIER_TRAEFIK_CONFIG=

# SQLite database for the audit log and login limiter (#80). Default ./data/pier.db
# (gitignored). The Deployment sets /data/pier.db on the pier-backend-data PVC.
PIER_DB_PATH=

# Days to keep audit log rows and finished deploys (1-3650, default 90). Older rows are pruned hourly.
PIER_AUDIT_RETENTION_DAYS=

# Seconds a deploy may run before it is marked failed (30-3600, default 300) (#81).
PIER_DEPLOY_TIMEOUT_SECONDS=

# Absolute path to kubeconfig (~ is NOT expanded in .env files). Used for local development and deploy scripts.
KUBECONFIG=/path/to/kubeconfig-file

# Deploy to k3s cluster (only for scripts/deploy-local.sh; pod uses ServiceAccount token)
K3S_HOST=192.0.2.10
K3S_SSH_USER=your-ssh-user

# Dockerfile builds (#83): in-cluster registry NodePort host:port written into image refs.
# Run ./scripts/configure-k3s-registry.sh once so k3s can pull from this address.
PIER_BUILD_REGISTRY=localhost:30500

# Where Kaniko pushes (in-cluster Service). Default registry.<namespace>.svc.cluster.local:5000.
# Leave empty unless you changed the registry Service name or port.
PIER_BUILD_PUSH_REGISTRY=

# Namespace for the registry Deployment and Kaniko Jobs (default pier-system).
PIER_BUILD_NAMESPACE=pier-system

# Max seconds a Kaniko build may run (60-3600, default 900).
PIER_BUILD_TIMEOUT_SECONDS=

# Kaniko executor image (pin when bumping).
PIER_KANIKO_IMAGE=
