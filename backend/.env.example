# HTTP bind (default 127.0.0.1 for dev; 0.0.0.0 requires PIER_API_TOKEN in deployment)
PORT=3000
HOST=127.0.0.1

# API security: bearer token for all routes except /health (k8s probes).
# Generate one with: openssl rand -hex 32
# Leave empty for dev on loopback only (requires Host to be 127.0.0.1 or ::1).
PIER_API_TOKEN=

# Kubernetes namespace for pier app workloads (used by later API routes)
PIER_NAMESPACE=pier-apps

# Local dev on Beater: absolute path to kubeconfig (~ is NOT expanded in .env files)
KUBECONFIG=/path/to/kubeconfig-file

# In-cluster: leave KUBECONFIG unset; the app uses the pod ServiceAccount.
