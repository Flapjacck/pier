# deployment.yaml.tmpl
# Rendered by deploy-local.sh: __IMAGE__ and __TOKEN_SHA256__ are substituted.
# Do not kubectl apply this template directly; use deploy-local.sh instead.
# 
# The pod-template annotation pier.dev/token-sha256 ensures that when PIER_API_TOKEN
# changes, the pod template hash changes, triggering a rollout without needing
# kubectl set image or manual intervention.

apiVersion: apps/v1
kind: Deployment
metadata:
  name: pier-backend
  namespace: default
  labels:
    app: pier-backend
    app.kubernetes.io/part-of: pier
spec:
  replicas: 1
  revisionHistoryLimit: 3
  selector:
    matchLabels:
      app: pier-backend
  template:
    metadata:
      labels:
        app: pier-backend
      annotations:
        pier.dev/token-sha256: "__TOKEN_SHA256__"
    spec:
      serviceAccountName: pier-backend
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      volumes:
        - name: tmp
          emptyDir: {}
      containers:
        - name: api
          image: __IMAGE__
          imagePullPolicy: Never
          ports:
            - name: http
              containerPort: 3000
          env:
            - name: PORT
              value: "3000"
            - name: HOST
              value: "0.0.0.0"
            - name: PIER_NAMESPACE
              value: "pier-apps"
            - name: PIER_API_TOKEN
              valueFrom:
                secretKeyRef:
                  name: pier-backend-secrets
                  key: PIER_API_TOKEN
          resources:
            requests:
              cpu: 50m
              memory: 96Mi
            limits:
              cpu: 500m
              memory: 256Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          volumeMounts:
            - name: tmp
              mountPath: /tmp
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 3
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 5
            periodSeconds: 20
