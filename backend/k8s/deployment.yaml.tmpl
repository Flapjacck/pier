# deployment.yaml.tmpl
# Rendered by deploy-local.sh with these placeholder substitutions:
#   __IMAGE__ - Docker image tag (e.g. pier-backend:abc123def)
#   __TOKEN_SHA256__ - SHA256 hash of PIER_API_TOKEN (for token rotation detection)
#   __INGRESS_DOMAIN__ - Wildcard DNS suffix (e.g. 192.0.2.10.nip.io)
#   __DASHBOARD_HOST__ - Dashboard hostname (e.g. pier.192.0.2.10.nip.io)
#   __TLS_ISSUER__     - cert-manager ClusterIssuer for app Ingresses; empty = no TLS
# Do not kubectl apply this template directly; use deploy-local.sh instead.
#
# The pod-template annotation pier.dev/token-sha256 ensures that when PIER_API_TOKEN
# changes, the pod template hash changes, triggering a rollout without needing
# manual kubectl set image intervention.

apiVersion: apps/v1
kind: Deployment
metadata:
  name: pier-backend
  namespace: default
  labels:
    app: pier-backend
    app.kubernetes.io/part-of: pier
spec:
  replicas: 1
  revisionHistoryLimit: 3
  # The data volume is ReadWriteOnce (one pod at a time), so stop the old pod before
  # starting the new one. Costs a few seconds of downtime per deploy.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: pier-backend
  template:
    metadata:
      labels:
        app: pier-backend
      annotations:
        pier.dev/token-sha256: "__TOKEN_SHA256__"
    spec:
      serviceAccountName: pier-backend
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      volumes:
        - name: tmp
          emptyDir: {}
        - name: data
          persistentVolumeClaim:
            claimName: pier-backend-data
      containers:
        - name: api
          image: __IMAGE__
          imagePullPolicy: Never
          ports:
            - name: http
              containerPort: 3000
          env:
            - name: PORT
              value: "3000"
            - name: HOST
              value: "0.0.0.0"
            - name: PIER_NAMESPACE
              value: "pier-apps"
            - name: PIER_INGRESS_DOMAIN
              value: "__INGRESS_DOMAIN__"
            # Only Traefik (in the k3s pod CIDR) may set X-Forwarded-For, so req.ip is the
            # real client for the login limiter and audit log and cannot be spoofed.
            - name: PIER_TRUST_PROXY
              value: "10.42.0.0/16"
            - name: PIER_DASHBOARD_HOST
              value: "__DASHBOARD_HOST__"
            - name: PIER_TLS_ISSUER
              value: "__TLS_ISSUER__"
            - name: PIER_DB_PATH
              value: "/data/pier.db"
            - name: PIER_API_TOKEN
              valueFrom:
                secretKeyRef:
                  name: pier-backend-secrets
                  key: PIER_API_TOKEN
          resources:
            requests:
              cpu: 50m
              memory: 96Mi
            limits:
              cpu: 500m
              memory: 256Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          volumeMounts:
            - name: tmp
              mountPath: /tmp
            - name: data
              mountPath: /data
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 3
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 5
            periodSeconds: 20
