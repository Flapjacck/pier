{
  "name": "pier-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "start:prod": "node dist/index.js",
    "test": "node --import tsx --test 'tests/**/*.test.ts'",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "tsup": {
    "entry": ["src/index.ts"],
    "format": ["esm"],
    "target": "node20",
    "sourcemap": true,
    "clean": true
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.16.0"
  }
}
