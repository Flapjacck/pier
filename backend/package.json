{
  "name": "pier-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "tsx src/index.ts",
    "start:prod": "node dist/index.js"
  },
  "tsup": {
    "entry": ["src/index.ts"],
    "format": ["esm"],
    "target": "node20",
    "sourcemap": true,
    "clean": true
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
